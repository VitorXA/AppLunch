# Copie para ".env" e ajuste. O .env NUNCA deve ser commitado (já está no .gitignore).

# ── Servidor ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Arquivo do banco SQLite (a pasta é criada automaticamente)
DATABASE_PATH=./data/applunch.db
# Pasta com o build do frontend (gerada por `npm run build`)
STATIC_DIR=dist
# Fuso horário usado para decidir "hoje" e as janelas de refeição (nome IANA)
APP_TIMEZONE=America/Fortaleza

# ── Refeições ────────────────────────────────────────────────────────────
# JSON com as refeições e janelas (HH:MM, mesmo dia). O aluno só registra dentro da janela
# e uma vez por refeição por dia. Exemplo com duas refeições:
# MEAL_TYPES=[{"id":"breakfast","label":"Café da manhã","start":"07:00","end":"08:30"},{"id":"lunch","label":"Almoço","start":"11:00","end":"14:00"}]
# Padrão: almoço das 11:00 às 14:00.

# ── Contas ───────────────────────────────────────────────────────────────
# Regex que valida a matrícula/identificador. Exemplos:
#   SUAP (14 dígitos):  ^\d{14}$
#   Padrão do template: ^[A-Za-z0-9._-]{3,32}$
# ID_PATTERN=^[A-Za-z0-9._-]{3,32}$
# Cadastro aberto a qualquer pessoa? Use false para fechar.
REGISTRATION_OPEN=true
# Se definido, o cadastro exige este código de convite (distribua só aos alunos).
# REGISTRATION_CODE=
# Horas de duração da sessão
SESSION_TTL_HOURS=12
# Atrás de proxy reverso (Nginx, Caddy, Cloudflare)? Use true para ler o IP do X-Forwarded-For.
# Só ative se o proxy realmente sobrescreve esse cabeçalho, senão o limite de tentativas pode ser burlado.
TRUST_PROXY=false
# Cookie com flag Secure (padrão: true em produção). Exige HTTPS.
# COOKIE_SECURE=true

# Cria uma conta de administrador na primeira inicialização (se ainda não existir).
# Defina uma senha forte (mín. 8 caracteres) e remova estas linhas depois do primeiro start.
# ADMIN_ID=admin
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador

# ── Reconhecimento facial ────────────────────────────────────────────────
# mock = SÓ DESENVOLVIMENTO (aceita qualquer rosto; o servidor recusa iniciar em produção com ele)
# http = delega a um serviço seu (veja docs/FACE-RECOGNITION.md)
FACE_PROVIDER=mock
# FACE_SERVICE_URL=http://localhost:8000
# FACE_SERVICE_TOKEN=
# Tamanho máximo da foto enviada, em bytes
# MAX_IMAGE_BYTES=1500000

# ── Frontend (lidas pelo Vite no build) ──────────────────────────────────
# VITE_APP_NAME=AppLunch
# Como sua instituição chama o número do aluno (aparece nos formulários): SUAP, RA, Matrícula…
# VITE_ID_LABEL=Matrícula
